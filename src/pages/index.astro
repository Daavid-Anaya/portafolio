---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Certifications from "@/components/sections/Certifications.astro";
import Contact from "@/components/sections/Contact.astro";
---

<Layout
  title="Portafolio"
  description="Portafolio de David Villegas Anaya, desarrollador backend con Java y Spring Boot, estudiante de Computer Science en BUAP."
>
  <!--
    Section order matches nav anchor links:
    #inicio → #sobre-mi → #proyectos → #habilidades → #certificaciones → #contacto
    Each section manages its own scroll-reveal via [data-animate] + AnimatedSection.
    The animate.ts IntersectionObserver is loaded once in Layout.astro — no duplication.
  -->

  <!-- 1. Hero — first impression, typewriter, CTAs -->
  <Hero />

  <!-- Divider: subtle section separator -->
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <hr class="border-surface-600/50" />
  </div>

  <!-- 2. About — story, stats, tech pills -->
  <About />

  <!-- Divider -->
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <hr class="border-surface-600/50" />
  </div>

  <!-- 3. Projects — card grid, featured project, GitHub CTA -->
  <Projects />

  <!-- Divider -->
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <hr class="border-surface-600/50" />
  </div>

  <!-- 4. Skills — categorised skill grid with mastered/learning distinction -->
  <Skills />

  <!-- Divider -->
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <hr class="border-surface-600/50" />
  </div>

  <!-- 5. Certifications — earned vs in-progress cards -->
  <Certifications />

  <!-- Divider -->
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 lg:px-8" aria-hidden="true">
    <hr class="border-surface-600/50" />
  </div>

  <!-- 6. Contact — form + direct links -->
  <Contact />
</Layout>
