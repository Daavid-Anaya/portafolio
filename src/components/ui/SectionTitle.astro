---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  class?: string;
}

const { title, subtitle, id, class: className } = Astro.props;
---

<div class:list={["mb-12 text-center", className]}>
  <h2
    id={id}
    class="relative inline-block text-3xl font-bold text-text-primary sm:text-4xl"
  >
    {title}
    <!-- Violet accent underline -->
    <span
      class="absolute -bottom-2 left-0 h-1 w-full rounded-full bg-violet-500"
      aria-hidden="true"
    ></span>
  </h2>

  {
    subtitle && (
      <p class="mt-6 text-base text-text-secondary sm:text-lg">{subtitle}</p>
    )
  }
</div>
