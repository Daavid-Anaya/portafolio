---
import AnimatedSection from "@/components/ui/AnimatedSection.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { experienceItems } from "@/data/experience";

const activeExperienceId = experienceItems[0]?.id;
---

<section
  id="experiencia"
  class="bg-black px-4 py-24 sm:px-6 lg:px-8"
  aria-labelledby="experience-title"
>
  <div class="mx-auto max-w-[1080px]">
    <AnimatedSection animation="fade-up">
      <SectionTitle
        title="Experiencia"
        subtitle="Una mirada breve a los espacios donde he aprendido, construido y colaborado"
        id="experience-title"
      />
    </AnimatedSection>

    <AnimatedSection animation="fade-up" delay={120}>
      <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-12">
        <div
          class="-mx-4 overflow-x-auto border-b border-violet-500/20 px-4 pb-3 lg:mx-0 lg:overflow-visible lg:border-b-0 lg:border-l lg:px-0 lg:pb-0 lg:pl-4"
          role="tablist"
          aria-label="Experiencias profesionales y formativas"
          data-experience-tabs
        >
          <div class="flex min-w-max gap-2 lg:min-w-0 lg:flex-col lg:gap-1">
            {experienceItems.map((item) => {
              const isActive = item.id === activeExperienceId;

              return (
                <button
                  type="button"
                  id={`experience-tab-${item.id}`}
                  class:list={[
                    "inline-flex min-h-11 touch-manipulation items-center whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold transition-colors duration-normal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400 lg:w-full lg:rounded-l-full lg:rounded-r-none lg:text-left",
                    isActive
                      ? "bg-violet-500 text-white shadow-lg shadow-violet-500/20"
                      : "text-slate-400 hover:bg-violet-500/10 hover:text-slate-100",
                  ]}
                  role="tab"
                  aria-selected={isActive ? "true" : "false"}
                  aria-controls={`experience-panel-${item.id}`}
                  tabindex={isActive ? "0" : "-1"}
                  data-experience-tab
                  data-target={item.id}
                >
                  {item.label}
                </button>
              );
            })}
          </div>
        </div>

        <div class="min-w-0">
          {experienceItems.map((item) => {
            const isActive = item.id === activeExperienceId;

            return (
              <article
                id={`experience-panel-${item.id}`}
                class:list={["space-y-8", !isActive && "hidden"]}
                role="tabpanel"
                aria-labelledby={`experience-tab-${item.id}`}
                tabindex="0"
                hidden={!isActive}
                data-experience-panel
                data-panel={item.id}
              >
                <header class="space-y-2">
                  <p class="text-sm font-semibold text-violet-400">{item.period}</p>
                  <h3 class="text-2xl font-bold leading-tight text-slate-50 sm:text-3xl">
                    {item.title}
                  </h3>
                  <p class="text-base text-slate-400">{item.label}</p>
                </header>

                <div class="space-y-6">
                  {item.groups.map((group) => (
                    <section class="border-l-2 border-violet-500/70 pl-5">
                      <h4 class="text-sm font-semibold uppercase tracking-[0.18em] text-violet-300">
                        {group.heading}
                      </h4>
                      <ul class="mt-3 space-y-2" aria-label={`${group.heading} — ${item.label}`}>
                        {group.bullets.map((bullet) => (
                          <li class="text-sm leading-relaxed text-slate-300 sm:text-base">
                            {bullet}
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </AnimatedSection>
  </div>
</section>

<script>
  const tabLists = document.querySelectorAll<HTMLElement>("[data-experience-tabs]");

  tabLists.forEach((tabList) => {
    const tabs = Array.from(tabList.querySelectorAll<HTMLButtonElement>("[data-experience-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-experience-panel]"));

    function activateTab(nextTab: HTMLButtonElement, shouldFocus = true): void {
      const target = nextTab.dataset.target;
      if (!target) return;

      tabs.forEach((tab) => {
        const isSelected = tab === nextTab;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        tab.classList.toggle("bg-violet-500", isSelected);
        tab.classList.toggle("text-white", isSelected);
        tab.classList.toggle("shadow-lg", isSelected);
        tab.classList.toggle("shadow-violet-500/20", isSelected);
        tab.classList.toggle("text-slate-400", !isSelected);
        tab.classList.toggle("hover:bg-violet-500/10", !isSelected);
        tab.classList.toggle("hover:text-slate-100", !isSelected);
      });

      panels.forEach((panel) => {
        const isTargetPanel = panel.dataset.panel === target;
        panel.hidden = !isTargetPanel;
        panel.classList.toggle("hidden", !isTargetPanel);
      });

      if (shouldFocus) {
        nextTab.focus();
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab, false));

      tab.addEventListener("keydown", (event) => {
        const lastIndex = tabs.length - 1;
        let nextIndex = index;

        if (event.key === "ArrowDown" || event.key === "ArrowRight") {
          nextIndex = index === lastIndex ? 0 : index + 1;
        } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
          nextIndex = index === 0 ? lastIndex : index - 1;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = lastIndex;
        } else {
          return;
        }

        event.preventDefault();
        activateTab(tabs[nextIndex]);
      });
    });
  });
</script>
