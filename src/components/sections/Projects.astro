---
import AnimatedSection from "@/components/ui/AnimatedSection.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import ExternalLinkIcon from "@/components/icons/ExternalLink.astro";
import { projects } from "@/data/projects";

const publicAsset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, "")}`;
---

<section
  id="proyectos"
  class="px-4 py-24 sm:px-6 lg:px-8"
  aria-labelledby="projects-title"
>
  <div class="mx-auto max-w-[1100px]">
    <AnimatedSection animation="fade-up">
      <SectionTitle
        title="Proyectos"
        subtitle="Trabajo real, problemas reales"
        id="projects-title"
      />
    </AnimatedSection>

    {projects.length === 0 && (
      <p class="text-center text-text-secondary">Proyectos en construcción — volvé pronto</p>
    )}

    <div class="grid gap-8 lg:grid-cols-2">
      {
        projects.map((project, i) => (
          <AnimatedSection
            animation="fade-up"
            delay={i * 150}
            class={project.featured && i === 0 ? "lg:col-span-2" : ""}
          >
            <article
              class:list={[
                "group relative flex h-full flex-col overflow-hidden rounded-2xl border bg-surface-800 transition-all duration-normal",
                "hover:border-violet-500/50 hover:shadow-xl hover:shadow-violet-500/10",
                project.featured && i === 0
                  ? "border-violet-500/40 shadow-lg shadow-violet-500/10"
                  : "border-surface-600",
              ]}
              aria-label={`Proyecto: ${project.title}`}
            >
              {/* Featured accent line */}
              {project.featured && i === 0 && (
                <div
                  class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-violet-500 via-violet-400 to-cyan-400"
                  aria-hidden="true"
                />
              )}

              {/* Project image — real screenshot with placeholder fallback */}
              <div
                class:list={[
                  "relative overflow-hidden",
                  project.featured && i === 0 ? "h-48 sm:h-56" : "h-40",
                ]}
              >
                {project.imageUrl ? (
                  <img
                    src={publicAsset(project.imageUrl)}
                    alt={project.imageAlt}
                    class="h-full w-full object-cover transition-transform duration-slow group-hover:scale-105"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                ) : (
                  <div
                    class:list={[
                      "absolute inset-0 flex items-center justify-center",
                      i === 0
                        ? "bg-gradient-to-br from-violet-950 via-violet-900/50 to-surface-800"
                        : "bg-gradient-to-br from-surface-700 via-surface-800 to-surface-900",
                    ]}
                    aria-hidden="true"
                  >
                    {/* Abstract pattern */}
                    <div class="absolute inset-0 bg-[linear-gradient(45deg,#ffffff04_25%,transparent_25%,transparent_50%,#ffffff04_50%,#ffffff04_75%,transparent_75%)] bg-[size:16px_16px]" />
                    <div
                      class:list={[
                        "relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl border",
                        i === 0
                          ? "border-violet-500/40 bg-violet-500/20 text-violet-400"
                          : "border-surface-600 bg-surface-700 text-text-secondary",
                      ]}
                    >
                      {/* Simple server/api icon */}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                        <line x1="6" y1="6" x2="6.01" y2="6" />
                        <line x1="6" y1="18" x2="6.01" y2="18" />
                      </svg>
                    </div>
                  </div>
                )}
              </div>

              {/* Content */}
              <div class="flex flex-1 flex-col p-6">
                {/* Tags */}
                <div class="mb-3 flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <Badge text={tag} variant={project.featured && i === 0 ? "accent" : "default"} />
                  ))}
                </div>

                {/* Title */}
                <h3
                  class:list={[
                    "mb-2 font-bold leading-snug text-text-primary",
                    project.featured && i === 0 ? "text-xl sm:text-2xl" : "text-lg",
                  ]}
                >
                  {project.title}
                </h3>

                {/* Description */}
                <p class="mb-6 flex-1 text-sm leading-relaxed text-text-secondary">
                  {project.description}
                </p>

                {/* Tech stack */}
                <div class="mb-6">
                  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-text-muted">
                    Tecnologías
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {project.techStack.map((tech) => (
                      <span class="rounded border border-surface-600 bg-surface-700 px-2 py-0.5 text-xs text-text-secondary">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Action links */}
                <div class="flex flex-wrap gap-3">
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-lg border border-surface-600 bg-surface-700 px-4 py-2 text-sm font-medium text-text-secondary transition-all duration-normal hover:border-violet-500/50 hover:text-violet-400"
                      aria-label={`Ver código fuente de ${project.title} en GitHub (abre en nueva pestaña)`}
                    >
                      <GitHubIcon width={16} height={16} />
                      Código
                    </a>
                  )}
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-lg bg-violet-500 px-4 py-2 text-sm font-medium text-white transition-all duration-normal hover:bg-violet-600"
                      aria-label={`Ver demo en vivo de ${project.title} (abre en nueva pestaña)`}
                    >
                      <ExternalLinkIcon width={16} height={16} />
                      ver
                    </a>
                  )}
                  {!project.githubUrl && !project.liveUrl && (
                    <span class="inline-flex items-center gap-1.5 text-xs text-text-muted">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      Repositorio privado
                    </span>
                  )}
                </div>
              </div>
            </article>
          </AnimatedSection>
        ))
      }
    </div>

    <!-- GitHub CTA -->
    <AnimatedSection animation="fade-up" delay={300} class="mt-12 text-center">
      <p class="mb-4 text-text-secondary">
        ¿Quieres ver más proyectos?
      </p>
      <Button
        href="https://github.com/Daavid-Anaya"
        variant="secondary"
        size="md"
        aria-label="Ver perfil de GitHub de David Villegas (abre en nueva pestaña)"
      >
        <GitHubIcon width={18} height={18} />
        Ver perfil en GitHub
      </Button>
    </AnimatedSection>
  </div>
</section>
