---
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = "/og-image.svg",
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname.endsWith("/")
  ? `${Astro.url.pathname}index.html`
  : Astro.url.pathname;
const canonicalPath = currentPath.startsWith(basePath)
  ? currentPath
  : `${basePath}${currentPath.replace(/^\//, "")}`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const fullTitle = `${title} | David — Backend Developer`;
const getPublicAssetURL = (assetPath: string) => {
  const normalizedAssetPath = assetPath.replace(/^\//, "");
  return new URL(`${basePath}${normalizedAssetPath}`, Astro.site).toString();
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "David Villegas Anaya",
      "jobTitle": "Backend Developer",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Benemérita Universidad Autónoma de Puebla (BUAP)",
      },
      "knowsAbout": [
        "Java",
        "Spring Boot",
        "REST APIs",
        "Oracle Cloud Infrastructure",
        "PostgreSQL",
        "Docker",
      ],
      "url": canonicalURL.toString(),
      "sameAs": [
        "https://github.com/Daavid-Anaya",
        "https://www.linkedin.com/in/david-villegas-anaya",
      ],
    },
    {
      "@type": "WebSite",
      "name": "David — Backend Developer",
      "url": canonicalURL.toString(),
    },
  ],
};
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Canonical & Sitemap -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={getPublicAssetURL("sitemap-index.xml")} />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David Villegas Anaya" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={getPublicAssetURL(ogImage)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="David — Backend Developer" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={getPublicAssetURL(ogImage)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={getPublicAssetURL("favicon.svg")} />

    <!-- Fonts: Inter Variable via Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen">
    <!-- ─── Sticky Navigation ─── -->
    <header class="sticky top-0 z-50 w-full border-b border-surface-600 bg-bg-base/80 backdrop-blur-md">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
        aria-label="Navegación principal"
      >
        <!-- Logo / Brand -->
        <a
          href="/"
          class="text-lg font-bold text-violet-400 transition-colors hover:text-violet-300"
          aria-label="Inicio — David Villegas"
        >
          David<span class="text-text-secondary">.</span>
        </a>

        <!-- Desktop Nav Links -->
        <ul class="hidden items-center gap-1 md:flex" role="list">
          {[
            { label: "Sobre Mí", href: "#sobre-mi" },
            { label: "Proyectos", href: "#proyectos" },
            { label: "Habilidades", href: "#habilidades" },
            { label: "Certificaciones", href: "#certificaciones" },
            { label: "Contacto", href: "#contacto" },
          ].map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="rounded-md px-3 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-surface-700 hover:text-text-primary"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Mobile: CSS-only hamburger using <details> -->
        <details class="relative md:hidden">
          <summary
            class="cursor-pointer list-none rounded-md p-2 text-text-secondary hover:bg-surface-700 hover:text-text-primary"
            aria-label="Abrir menú de navegación"
          >
            <!-- Hamburger icon -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </summary>
          <ul
            class="absolute right-0 top-full mt-2 w-48 rounded-xl border border-surface-600 bg-surface-800 p-2 shadow-xl"
            role="list"
          >
            {[
              { label: "Sobre Mí", href: "#sobre-mi" },
              { label: "Proyectos", href: "#proyectos" },
              { label: "Habilidades", href: "#habilidades" },
              { label: "Certificaciones", href: "#certificaciones" },
              { label: "Contacto", href: "#contacto" },
            ].map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="block rounded-lg px-3 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-surface-700 hover:text-text-primary"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>

    <!-- ─── Main Content ─── -->
    <main>
      <slot />
    </main>

    <!-- ─── Footer ─── -->
    <footer class="mt-20 border-t border-surface-600">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
          <!-- Copyright -->
          <p class="text-sm text-text-muted">
            © {new Date().getFullYear()} David Anaya. Todos los derechos reservados.
          </p>

          <!-- Social Links -->
          <div class="flex items-center gap-4">
            <a
              href="https://github.com/Daavid-Anaya"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted transition-colors hover:text-violet-400"
              aria-label="GitHub de David Villegas (abre en nueva pestaña)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.605-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12c0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/david-villegas-anaya"
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted transition-colors hover:text-violet-400"
              aria-label="LinkedIn de David Villegas (abre en nueva pestaña)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Animation script — Vite processes this TypeScript module -->
    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      function revealAll(elements: NodeListOf<Element>): void {
        elements.forEach((el) => el.setAttribute("data-animate", "visible"));
      }

      function initObserver(elements: NodeListOf<Element>): void {
        if (elements.length === 0) return;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.setAttribute("data-animate", "visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
        );
        elements.forEach((el) => observer.observe(el));
      }

      const elements = document.querySelectorAll("[data-animate]");
      if (reduceMotion.matches) {
        revealAll(elements);
      } else {
        initObserver(elements);
      }
    </script>
  </body>
</html>
